# ======================================================
# Alibi — AI アリバイ素材メーカー
# ======================================================

# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alibi?schema=public"

# ---- NextAuth ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"

# ---- Stripe ----
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLIC_KEY="pk_test_xxx"

# ---- Object Storage (S3-compatible: MinIO / R2 / S3) ----
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_PUBLIC_BUCKET="alibi-public"
S3_PRIVATE_BUCKET="alibi-private"
S3_PUBLIC_BASE_URL="http://localhost:9000/alibi-public"

# ---- AI (Replicate) ----
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""
# Override model (default: omniedgeio/face-swap)
# REPLICATE_MODEL="omniedgeio/face-swap:c2d783366..."

# ---- Background Jobs ----
# "true" = enqueue to DB, "false" = run inline (default)
ASYNC_PROCESSING="false"
JOBS_WORKER_SECRET="change-me"
