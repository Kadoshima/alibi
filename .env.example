# ======================================================
# Alibi Photo Market — environment variables
# ======================================================

# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alibi?schema=public"

# ---- NextAuth ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"

# ---- Stripe ----
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLIC_KEY="pk_test_xxx"

# ---- Object Storage (S3-compatible: MinIO / R2 / S3) ----
# For local dev, docker-compose starts a MinIO instance on :9000.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_PUBLIC_BUCKET="alibi-public"
S3_PRIVATE_BUCKET="alibi-private"
# Public CDN base URL for MASKED/THUMB assets.
S3_PUBLIC_BASE_URL="http://localhost:9000/alibi-public"

# ---- Face detection ----
# stub (default) or rekognition
FACE_DETECTION_PROVIDER="stub"
# Only required if provider = rekognition
AWS_REGION="ap-northeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ---- Background job queue ----
# Set to "true" to dispatch photo processing to the async worker.
ASYNC_PROCESSING="false"
# Shared secret for POST /api/jobs/worker (Vercel Cron / QStash / GitHub Actions).
JOBS_WORKER_SECRET="change-me-to-a-long-random-string"

# ---- Email (optional) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@alibi.example.com"
