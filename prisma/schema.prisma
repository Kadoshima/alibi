// Prisma schema — Alibi (アリバイ素材メーカー)
//
// AI顔合成 + チケット日付編集ツール。
// 「今日○○にいた」を証明する素材を自分のために作れるサービス。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionPlan {
  FREE      // 月2枚
  PRO       // 月30枚, ¥980
  UNLIMITED // 無制限, ¥2,980
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum TemplateCategory {
  CINEMA
  RESTAURANT
  BAR
  CAFE
  TRAVEL
  SPORTS
  SHOPPING
  OUTDOOR
  EVENT
  OTHER
}

enum GenerationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum CouponKind {
  PERCENT
  FIXED
}

// ---------------------------------------------------------------------------
// Users & Auth
// ---------------------------------------------------------------------------

model User {
  id                    String             @id @default(cuid())
  email                 String             @unique
  emailVerified         DateTime?
  name                  String?
  image                 String?
  passwordHash          String?
  role                  UserRole           @default(USER)
  locale                String             @default("ja")
  termsAcceptedAt       DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // Subscription
  subscriptionPlan      SubscriptionPlan   @default(FREE)
  subscriptionStatus    SubscriptionStatus @default(ACTIVE)
  subscriptionExpiresAt DateTime?
  stripeCustomerId      String?            @unique

  // Referral
  referralCode          String?            @unique
  referredById          String?
  referredBy            User?              @relation("UserReferrals", fields: [referredById], references: [id])
  referrals             User[]             @relation("UserReferrals")

  // Relations
  accounts           Account[]
  sessions           Session[]
  facePhotos         FacePhoto[]
  generations        Generation[]
  ticketEdits        TicketEdit[]
  creditBalance      CreditBalance?
  creditTransactions CreditTransaction[]
  auditLogs          AuditLog[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Face Photos (ユーザーの登録顔写真)
// ---------------------------------------------------------------------------

model FacePhoto {
  id        String   @id @default(cuid())
  userId    String
  s3Key     String
  bucket    String
  width     Int
  height    Int
  bytes     Int
  mimeType  String
  label     String?  // 「正面」「横顔」等の任意ラベル
  createdAt DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations Generation[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Templates (シーン別ベース画像、管理者がキュレーション)
// ---------------------------------------------------------------------------

model Template {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  description  String?
  category     TemplateCategory
  s3Key        String           // フルサイズのベース画像
  thumbS3Key   String           // サムネイル
  bucket       String
  premium      Boolean          @default(false) // プレミアム = 2クレジット
  active       Boolean          @default(true)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  generations Generation[]

  @@index([category])
  @@index([active, sortOrder])
}

// ---------------------------------------------------------------------------
// AI Generations (顔合成結果)
// ---------------------------------------------------------------------------

model Generation {
  id              String           @id @default(cuid())
  userId          String
  templateId      String?
  facePhotoId     String?
  status          GenerationStatus @default(QUEUED)
  // Custom prompt for freeform scene (future)
  prompt          String?          @db.Text
  // Replicate prediction ID
  replicatePredId String?
  // Result
  resultS3Key     String?
  resultBucket    String?
  creditsUsed     Int              @default(1)
  error           String?          @db.Text
  createdAt       DateTime         @default(now())
  completedAt     DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  template  Template?  @relation(fields: [templateId], references: [id])
  facePhoto FacePhoto? @relation(fields: [facePhotoId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Ticket Date Editing (チケット日付編集)
// ---------------------------------------------------------------------------

model TicketEdit {
  id             String   @id @default(cuid())
  userId         String
  originalS3Key  String
  originalBucket String
  editedS3Key    String?
  editedBucket   String?
  detectedDate   String?  // OCR で検出した元日付
  newDate        String?  // ユーザーが指定した新日付
  creditsUsed    Int      @default(1)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Credit System
// ---------------------------------------------------------------------------

model CreditBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  credits   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int      // positive = 追加, negative = 消費
  reason    String   // purchase, subscription_renewal, generation, ticket_edit, bonus, refund
  sourceId  String?  // 関連レコードID
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Stripe Payments (都度クレジット購入)
// ---------------------------------------------------------------------------

model CreditPurchase {
  id                      String   @id @default(cuid())
  userId                  String
  credits                 Int
  amountJpy               Int
  stripeCheckoutSessionId String?  @unique
  stripePaymentIntentId   String?  @unique
  status                  String   @default("PENDING") // PENDING | PAID | FAILED
  createdAt               DateTime @default(now())
  paidAt                  DateTime?

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Coupons
// ---------------------------------------------------------------------------

model Coupon {
  code           String     @id
  kind           CouponKind
  valueCredits   Int?       // FIXED: 付与クレジット数
  percentBps     Int?       // PERCENT: 追加%
  maxRedemptions Int?
  redeemedCount  Int        @default(0)
  validFrom      DateTime?
  validUntil     DateTime?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
}

// ---------------------------------------------------------------------------
// Background Jobs
// ---------------------------------------------------------------------------

model Job {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?   @db.Text
  runAfter    DateTime  @default(now())
  claimedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([kind])
}

// ---------------------------------------------------------------------------
// Analytics & Audit
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  path      String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
}
