// Prisma schema — Alibi Photo Market
//
// Design notes:
// - 写真(Photo)は 1:N で PhotoAsset を持つ(ORIGINAL / MASKED / THUMB)
// - 購入(PhotoPurchase)は 1:1 で Payment(Stripe)と紐づく
// - ライセンスは Photo 単位で許可種別を記録、購入時に具体 License を選択
// - Earning はクリエイターへの送金原資 ledger
// - AuditLog は全ての privileged 操作を記録

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  BUYER
  CREATOR
  ADMIN
}

enum PhotoStatus {
  DRAFT           // アップロード直後、処理待ち
  PROCESSING      // プライバシー処理中
  PENDING_REVIEW  // ユーザー承認待ち or 管理者審査待ち
  ACTIVE          // 公開中
  SUSPENDED       // 停止
  ARCHIVED        // アーカイブ
}

enum AssetVariant {
  ORIGINAL // 透かしなし原本(非公開、購入者のみ署名付きURLで取得)
  MASKED   // プライバシー処理済み(公開プレビュー)
  THUMB    // サムネイル(公開CDN配信)
}

enum LicenseKind {
  PERSONAL
  COMMERCIAL
  EXTENDED
}

enum PurchaseStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  REFUNDED
  FAILED
}

enum EarningSource {
  SALE
  REFERRAL
  BONUS
  ADJUSTMENT
}

enum EarningStatus {
  PENDING
  AVAILABLE
  PAID_OUT
  CANCELLED
}

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum CouponKind {
  PERCENT
  FIXED
}

// ---------------------------------------------------------------------------
// Users & Auth
// ---------------------------------------------------------------------------

model User {
  id                    String             @id @default(cuid())
  email                 String             @unique
  emailVerified         DateTime?
  name                  String?
  image                 String?
  passwordHash          String?
  role                  UserRole           @default(BUYER)
  locale                String             @default("ja")
  termsAcceptedAt       DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // 成長 & 収益
  referralCode          String?            @unique
  referredById          String?
  referredBy            User?              @relation("UserReferrals", fields: [referredById], references: [id])
  referrals             User[]             @relation("UserReferrals")
  subscriptionPlan      SubscriptionPlan   @default(FREE)
  subscriptionStatus    SubscriptionStatus @default(ACTIVE)
  subscriptionExpiresAt DateTime?
  stripeCustomerId      String?            @unique

  // クリエイター単位の手数料率(basis points: 2000 = 20%)
  platformFeeBps        Int                @default(2000)

  // Relations
  accounts   Account[]
  sessions   Session[]
  photos     Photo[]          @relation("OwnerPhotos")
  purchases  PhotoPurchase[]  @relation("BuyerPurchases")
  earnings   Earning[]
  reviews    PhotoReview[]    @relation("ReviewAuthor")
  auditLogs  AuditLog[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Photos & Assets
// ---------------------------------------------------------------------------

model Photo {
  id            String      @id @default(cuid())
  ownerId       String
  title         String
  slug          String      @unique
  description   String?     @db.Text
  status        PhotoStatus @default(DRAFT)

  // 価格(PERSONAL ライセンス基準、JPY)
  priceJpy      Int         @default(500)

  // 許可する最大ライセンス種別(PERSONAL のみ / COMMERCIAL まで / EXTENDED まで)
  maxLicense    LicenseKind @default(COMMERCIAL)

  // プライバシー処理結果(監査用)
  privacyFacesCount    Int  @default(0)
  privacyExifStripped  Boolean @default(false)
  privacyProcessedAt   DateTime?

  // 画像メタ(MASKED のもの)
  width         Int?
  height        Int?
  bytes         Int?
  mimeType      String?

  // 管理
  rejectedReason String?    @db.Text
  approvedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  owner      User            @relation("OwnerPhotos", fields: [ownerId], references: [id], onDelete: Cascade)
  assets     PhotoAsset[]
  tags       PhotoTag[]
  purchases  PhotoPurchase[]
  reviews    PhotoReview[]

  @@index([status])
  @@index([ownerId])
  @@index([createdAt])
}

model PhotoAsset {
  id        String       @id @default(cuid())
  photoId   String
  variant   AssetVariant
  bucket    String
  s3Key     String
  width     Int
  height    Int
  bytes     Int
  mimeType  String
  createdAt DateTime     @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, variant])
  @@index([photoId])
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())

  photos PhotoTag[]
}

model PhotoTag {
  photoId String
  tagId   String

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([photoId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Purchases & Payments
// ---------------------------------------------------------------------------

model PhotoPurchase {
  id                String         @id @default(cuid())
  buyerId           String
  photoId           String
  licenseKind       LicenseKind
  grossJpy          Int
  discountJpy       Int            @default(0)
  platformFeeJpy    Int
  creatorEarningsJpy Int
  couponCode        String?
  status            PurchaseStatus @default(PENDING)
  downloadCount     Int            @default(0)
  maxDownloads      Int            @default(5)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  paidAt            DateTime?

  buyer    User     @relation("BuyerPurchases", fields: [buyerId], references: [id])
  photo    Photo    @relation(fields: [photoId], references: [id])
  payment  Payment?
  coupon   Coupon?  @relation(fields: [couponCode], references: [code])

  @@index([buyerId])
  @@index([photoId])
  @@index([status])
}

model Payment {
  id                    String        @id @default(cuid())
  purchaseId            String        @unique
  amountJpy             Int
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  stripeCheckoutSessionId String?     @unique
  refundedJpy           Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  purchase PhotoPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Earning {
  id          String        @id @default(cuid())
  userId      String
  amountJpy   Int
  source      EarningSource
  status      EarningStatus @default(AVAILABLE)
  sourceId    String? // 関連レコード(purchase id 等)
  note        String?
  createdAt   DateTime      @default(now())
  paidOutAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model PhotoReview {
  id        String   @id @default(cuid())
  photoId   String
  authorId  String
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  photo  Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  author User  @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([photoId, authorId])
  @@index([photoId])
}

// ---------------------------------------------------------------------------
// Growth: Coupon
// ---------------------------------------------------------------------------

model Coupon {
  code           String     @id
  kind           CouponKind
  valueJpy       Int?
  percentBps     Int?
  maxRedemptions Int?
  redeemedCount  Int        @default(0)
  validFrom      DateTime?
  validUntil     DateTime?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())

  purchases PhotoPurchase[]
}

// ---------------------------------------------------------------------------
// Analytics & Audit
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  path      String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
}
